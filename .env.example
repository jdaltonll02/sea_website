APP_ENV=development
APP_URL=http://localhost:8000
APP_KEY=change-this-to-a-random-32-char-string

# Comma-separated list of email addresses that get unconditional SuperAdmin
# access, regardless of any role assigned in the database. This is the ONLY
# place SuperAdmin is configured — it cannot be granted through the dashboard.
SUPERADMIN_EMAILS=admin@southeasternarchdeaconry.org

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=saa_ecl
DB_USER=root
DB_PASS=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@southeasternarchdeaconry.org
SMTP_FROM_NAME="Southeastern Archdeaconry"

SESSION_LIFETIME=7200
